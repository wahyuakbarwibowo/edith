PORT=3000

# Supabase project (Settings → API). PUBLIC_* values are inlined into the browser bundle.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-side only: used by `bun run check:rls` to create/delete throwaway users. Never prefix with PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
