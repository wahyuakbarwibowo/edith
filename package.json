{
  "name": "trello-alternative",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked > src/shared/types/database.ts",
    "check:rls": "bun supabase/rls-check.ts",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
